{
  "name": "penguin-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The extension index for PenguinHarness: submissions, checks, and the generated index.json.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate": "tsx src/validate.ts",
    "check-npm": "tsx src/check-npm.ts",
    "build": "tsx src/build-index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "semver": "^7.6.3",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
