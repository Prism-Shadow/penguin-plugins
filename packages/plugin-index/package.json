{
  "name": "@prismshadow/penguin-plugin-index",
  "version": "0.1.0",
  "description": "The plugin entry format shared by the PenguinHarness plugin index and the harness's plugin store: the deterministic archiver, the integrity, the manifest and lock checks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-plugins.git",
    "directory": "packages/plugin-index"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.6.3"
  }
}
